# Copy this file to `.env` and replace the YOUR_... placeholders with your own
# Supabase values. README.md §6 Part C shows where to find them, Part D shows
# what to paste here. `npm run dev` from the repo root creates this .env for you
# if it is missing — it still needs your values pasted in.
PORT=8090

# Value 4 — the SAME Session pooler connection string used in
# appointmed_engine/.env. Use "Session pooler" from the Supabase dashboard
# (Connect), not "Direct connection": the direct host is IPv6-only and is
# unreachable on many home networks. URL-encode the password (@ becomes %40).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-YOUR_REGION.pooler.supabase.com:5432/postgres

ENGINE_URL=http://localhost:8080
# Must match POSTBACK_SECRET in appointmed_engine/.env. Localhost-only in this
# demo; change both for any real deployment.
POSTBACK_SECRET=appointmed-postback-demo-secret
