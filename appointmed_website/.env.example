# Optional. The portal reads its Supabase values from src/lib/config.js; setting
# them here instead (copy this file to `.env.local`, which git ignores) keeps them
# out of the source tree entirely. See README.md §6 Part D (D3).
#
# Only the anon/PUBLIC key belongs here — this file's values are bundled into the
# web page. Never put the service_role/secret key in it.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Where the portal looks for the two Node services. The defaults match `npm run dev`.
VITE_ENGINE_URL=http://localhost:8080
VITE_ADAPTER_URL=http://localhost:8090
