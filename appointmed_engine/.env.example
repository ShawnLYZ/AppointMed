# Copy this file to `.env` and replace every YOUR_... placeholder with your own
# Supabase values. README.md §6 Part C shows where to find each one, Part D shows
# exactly what to paste here. `npm run dev` from the repo root creates this .env
# for you if it is missing — it still needs your values pasted in.
#
# This file is the single source of truth for the engine's server-side values:
# `npm start`, `npm test`, and the repo-root `npm run db:*` scripts all read it.
PORT=8080

# Value 4 — Session pooler connection string (Supabase dashboard → Connect).
# Replace [YOUR-PASSWORD] with your database password, URL-encoded (@ becomes %40).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-YOUR_REGION.pooler.supabase.com:5432/postgres

# Value 1 — Project URL (Project Settings → Data API).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Value 2 — anon / public key (Project Settings → API Keys). Safe to expose.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Value 3 — service_role / secret key. NEVER commit this or put it in a client app.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

ADAPTER_URL=http://localhost:8090
# Shared secret for the adapter → engine callback, localhost-only in this demo.
# Must match POSTBACK_SECRET in appointmed_hospital_adapter/.env. Change both for
# any real deployment.
POSTBACK_SECRET=appointmed-postback-demo-secret
OLLAMA_URL=http://localhost:11434
MODEL_DEFAULT=gemma4:12b
MODEL_FALLBACK=qwen3.5:9b
# Optional per-stage overrides: MODEL_INTAKE / MODEL_TRIAGE / MODEL_PREFS / MODEL_RELAX / MODEL_SUMMARY
